FROM python:3.13-slim

# torch (pulled in by sentence-transformers) may be linked against libgomp at runtime and
# python:3.13-slim doesn't ship it. Kept as in v1: no CI step loads torch, so nothing proves it
# unneeded.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# /app is the repo root, so `src.api.main:app` resolves the same way it does locally.
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
