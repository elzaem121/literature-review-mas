# Required: contact email sent to OpenAlex (polite pool).
OPENALEX_EMAIL=

# Profile: `local` (real Ollama, real embedder) or `test` (fake LLM, fake embedder).
# PROFILE=local

# Ollama endpoint. Native Ollama: http://localhost:11434/v1
# docker compose: http://host.docker.internal:11434/v1 (set by docker-compose.yml)
OLLAMA_BASE_URL=

# Model per role (defaults: qwen2.5-coder:7b) and the embedding model
# (default: sentence-transformers/all-MiniLM-L6-v2).
# SEARCH_MODEL=
# SCREENING_MODEL=
# EXTRACTION_MODEL=
# EMBEDDING_MODEL=

# Directory for downloaded PDFs (default: pdfs_auto).
# PDF_DIR=

# Postgres connection (from commit 2a; compose default shown).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# LangSmith tracing (optional).
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Streamlit frontend: URL of the FastAPI backend.
BACKEND_URL=
